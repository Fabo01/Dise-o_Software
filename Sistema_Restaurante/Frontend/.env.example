# Variables de Entorno - Frontend del Sistema de Restaurante

# API Configuration
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_API_TIMEOUT=10000

# App Configuration
REACT_APP_NAME=Sistema de Gestión de Restaurante
REACT_APP_VERSION=1.0.0

# Development Settings
REACT_APP_DEBUG=true
REACT_APP_MOCK_API=false

# Authentication
REACT_APP_TOKEN_STORAGE_KEY=restaurante_token
REACT_APP_USER_STORAGE_KEY=restaurante_user

# UI Configuration
REACT_APP_ITEMS_PER_PAGE=10
REACT_APP_REFRESH_INTERVAL=30000

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_SOUND_ALERTS=true
REACT_APP_ENABLE_DARK_MODE=false

# Third Party Services (si se requieren en el futuro)
# REACT_APP_GOOGLE_MAPS_API_KEY=your_key_here
# REACT_APP_STRIPE_PUBLIC_KEY=your_key_here
